#!/usr/bin/env sh
# Runs a plugin hook under Python 3.11+: hooks/run <event>, the hook's JSON on stdin.
# The Python search is bin/dev-orchestra's, but a hook must never fail the
# session it runs in: with no suitable Python found this exits 0 and prints
# nothing, where bin/dev-orchestra exits 127. Only shell builtins are used
# before Python is found, so a bare PATH still ends quietly.

case $0 in
  */*) here=${0%/*} ;;
  *) here=. ;;
esac
root=$(cd -- "$here/.." 2>/dev/null && pwd) || exit 0

for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' </dev/null >/dev/null 2>&1; then
    # -I keeps PYTHONPATH and the user's site-packages out of a hook.
    "$candidate" -I "$root/scripts/hooks/reply_language.py" "$@"
    exit 0
  fi
done

exit 0
