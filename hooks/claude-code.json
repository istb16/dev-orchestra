{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" prompt", "timeout": 10}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" session-start", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" stop", "timeout": 10}
        ]
      }
    ]
  }
}
